{
  "name": "recall-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "build": "tsc -b && vite build && node scripts/cloudflare-content.mjs",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:worker": "node scripts/cloudflare-content.mjs && node --test worker/*.test.mjs",
    "upload:sources": "node scripts/cloudflare-content.mjs --upload",
    "deploy": "wrangler d1 migrations apply learner --remote && wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.86",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "ai": "^7.0.164",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
